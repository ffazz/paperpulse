// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql" // Atau "mysql" / "sqlite" sesuai database Anda
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTH MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  
  // Profile enhancement fields
  bio           String?   @db.Text
  favoriteGenres String[] @default([])
  location      String?
  website       String?
  twitter       String?
  instagram     String?
  goodreads     String?
  
  // Privacy & appearance settings
  isPublic      Boolean   @default(true)
  showEmail     Boolean   @default(false)
  showReadingGoal Boolean @default(true)
  coverImage    String?
  theme         String    @default("light") // light, dark, auto
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  bookmarks       Bookmark[]
  reviews         Review[]
  readingStatuses ReadingStatus[]
  readingLists    ReadingList[]
  readingGoals    ReadingGoal[]
  
  // Circle forum relations
  posts         Post[]
  comments      Comment[]
  postLikes     PostLike[]
  commentLikes  CommentLike[]
  
  // Profile system relations
  activities    UserActivity[]
  profileViews  ProfileView[] @relation("ProfileViewed")
  viewedProfiles ProfileView[] @relation("ProfileViewer")
  
  // Notification system relations
  notifications Notification[] @relation("UserNotifications")
  triggeredNotifications Notification[] @relation("NotificationActor")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// BOOKMARK & REVIEW MODELS
// ==========================================

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  bookId    Int
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  
  @@unique([userId, bookId])
  @@map("bookmarks")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    Int
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  
  @@unique([userId, bookId])
  @@map("reviews")
}

model ReadingStatus {
  id        String   @id @default(cuid())
  userId    String
  bookId    Int
  status    String
  progress  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  
  @@unique([userId, bookId])
  @@map("reading_statuses")
}

// ==========================================
// BOOK MODEL (UPDATED WITH NEW FIELDS)
// ==========================================

model Book {
  id               Int       @id @default(autoincrement())
  title            String
  authors          String[]
  translators      String[]  @default([])
  editors          String[]  @default([])
  reviewers        String[]  @default([])
  illustrators     String[]  @default([])
  series_editors   String[]  @default([])
  contributors     String[]  @default([])
  cover_image_url  String?
  epub_isbn        String?   @unique
  publisher        String?
  subjects         String[]
  language         String
  publication_date DateTime?
  description      String?   @db.Text
  
  // ✅ NEW FIELDS FOR RECOMMENDER SYSTEM
  pageCount        Int?
  averageRating    Float?
  ratingsCount     Int?
  categories       String[]  @default([])
  bookmarkCount    Int       @default(0)
  viewCount        Int       @default(0)
  discussionCount  Int       @default(0)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  bookmarks        Bookmark[]
  reviews          Review[]
  readingStatuses  ReadingStatus[]
  readingListBooks ReadingListBook[]
  posts            Post[]
  goalBooks        ReadingGoalBook[]

  @@index([language])
  @@index([publisher])
  @@index([title])
  @@index([bookmarkCount])
  @@index([viewCount])
  @@map("books")
}

// ==========================================
// READING LISTS MODELS
// ==========================================

model ReadingList {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  userId      String
  isPublic    Boolean  @default(false)
  shareSlug   String?  @unique @db.VarChar(12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  books ReadingListBook[]

  @@index([userId])
  @@index([shareSlug])
  @@index([updatedAt])
  @@map("reading_lists")
}

model ReadingListBook {
  id             String   @id @default(cuid())
  listId         String
  bookId         Int
  note           String?  @db.Text
  favoriteQuote  String?  @db.Text
  addedAt        DateTime @default(now())

  list ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([listId, bookId])
  @@index([listId])
  @@index([bookId])
  @@map("reading_list_books")
}

model ReadingGoal {
  id           String   @id @default(cuid())
  userId       String
  year         Int
  targetBooks  Int
  currentBooks Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  books ReadingGoalBook[]

  @@unique([userId, year])
  @@index([userId])
  @@map("reading_goals")
}

model ReadingGoalBook {
  id          String   @id @default(cuid())
  goalId      String
  bookId      Int
  status      String   @default("reading") // reading, completed
  startedAt   DateTime @default(now())
  completedAt DateTime?
  rating      Float?
  createdAt   DateTime @default(now())

  goal ReadingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  book Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([goalId, bookId])
  @@index([goalId])
  @@index([status])
  @@map("reading_goal_books")
}

// ==========================================
// CIRCLE FORUM MODELS
// ==========================================

model Post {
  id           String   @id @default(cuid())
  authorId     String
  title        String   @db.VarChar(200)
  content      String   @db.Text
  category     String   // Recommendation, Review, Quote, Discussion
  bookId       Int?
  tags         String[] @default([])
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  viewCount    Int      @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book     Book?      @relation(fields: [bookId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    PostLike[]

  @@index([category])
  @@index([authorId])
  @@index([bookId])
  @@index([createdAt])
  @@index([likeCount])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text
  parentId  String?
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]    @relation("CommentReplies")
  likes    CommentLike[]

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

// ==========================================
// USER ACTIVITY & PROFILE SYSTEM
// ==========================================

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // created_list, added_book_to_list, completed_book, created_post, wrote_review, achieved_goal, started_reading, bookmarked_book
  metadata  Json     // Flexible field for activity-specific data
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("user_activities")
}

model ProfileView {
  id             String   @id @default(cuid())
  profileUserId  String
  viewerUserId   String?
  viewedAt       DateTime @default(now())

  profileUser User   @relation("ProfileViewed", fields: [profileUserId], references: [id], onDelete: Cascade)
  viewer      User?  @relation("ProfileViewer", fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([profileUserId])
  @@index([viewedAt])
  @@map("profile_views")
}

// ==========================================
// NOTIFICATION SYSTEM
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // post_like, post_comment, comment_reply, comment_like, list_public, goal_milestone, streak_achievement, system_announcement
  title     String
  message   String   @db.Text
  actionUrl String?
  actorId   String?
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
